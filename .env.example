# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=your_gemini_api_key

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional PostgreSQL connection string for managed hosts such as Render.
DATABASE_URL=

# Redis / BullMQ Configuration (default local Docker Redis)
REDIS_URL="redis://127.0.0.1:6379"

# Elasticsearch Configuration (default local Docker Elasticsearch)
ELASTICSEARCH_URL="http://127.0.0.1:9200"
ELASTICSEARCH_API_KEY=

# Slack OAuth v2 Configuration (Optional - enables live Slack rate-limit alerts)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_STATE_SECRET=

# Email Scheduler & Rate Limiting Defaults
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
ETHEREAL_AUTO_PROVISION=true

# System Verification Mailer (Optional - set for real inbox delivery of signup verification emails)
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=465
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASS=
SYSTEM_FROM_NAME="Outboxly"
SYSTEM_FROM_EMAIL=
RESEND_API_KEY=
